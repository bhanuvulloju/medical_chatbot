name: Medibot-cicd-pipeline

on:
  push:
    branches: ["main"]

jobs:
  Build:
    runs-on: ubuntu-latest
    outputs:
      image: ${{ steps.set-image.outputs.image }}
    permissions:
      id-token: write   # required for workload identity federation
      contents: read

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Authenticate to Google Cloud
        uses: google-github-actions/auth@v2
        with:
          token_format: access_token
          workload_identity_provider: projects/430171683140/locations/global/workloadIdentityPools/github-wif/providers/github
          service_account: github-gcp-medibot@learnerspace-412414.iam.gserviceaccount.com

      - name: Setup gcloud
        uses: google-github-actions/setup-gcloud@v2
        with:
          project_id: learnerspace-412414

      - name: Verify authentication
        run: gcloud auth list

      - name: compute instances list
        run: gcloud compute instances list

      # Configure Docker to use gcloud as a credential helper
      - name: Configure Docker
        run: gcloud auth configure-docker us-central1-docker.pkg.dev --quiet

      # Build Docker image
      - name: Build Docker image
        run: |
          IMAGE="us-central1-docker.pkg.dev/learnerspace-412414/medibot/medibot-app"
          TAG="${GITHUB_SHA}"
          docker build -t $IMAGE:$TAG .

      # Push Docker image
      - name: Push Docker image
        run: |
          IMAGE="us-central1-docker.pkg.dev/learnerspace-412414/medibot/medibot-app"
          TAG="${GITHUB_SHA}"
          docker push $IMAGE:$TAG

      - name: Set image output
        id: set-image
        run: |
          IMAGE="us-central1-docker.pkg.dev/learnerspace-412414/medibot/medibot-app"
          TAG="${GITHUB_SHA}"
          echo "image=$IMAGE:$TAG" >> $GITHUB_OUTPUT


  Deploy:
    runs-on: ubuntu-latest
    needs: Build   # waits for build job
    permissions:
      id-token: write
      contents: read

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Authenticate to Google Cloud
        uses: google-github-actions/auth@v2
        with:
          token_format: access_token
          workload_identity_provider: projects/430171683140/locations/global/workloadIdentityPools/github-wif/providers/github
          service_account: github-gcp-medibot@learnerspace-412414.iam.gserviceaccount.com

      - name: Setup gcloud
        uses: google-github-actions/setup-gcloud@v2
        with:
          project_id: learnerspace-412414


      # Deploy to Cloud Run
      - name: Deploy to Cloud Run
        run: |
          IMAGE="${{ needs.Build.outputs.image }}"
          gcloud run deploy medibot-app \
            --image $IMAGE \
            --region us-central1 \
            --platform managed \
            --allow-unauthenticated